{
  "name": "interview-assistant-desktop",
  "version": "1.0.0",
  "description": "Interview Assistant Desktop App",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "webpack serve --config webpack.config.js --mode development",
    "dev:main": "tsc -p tsconfig.main.json",
    "dev": "npm run dev:main && concurrently -n renderer,electron \"npm run dev:renderer\" \"wait-on http://localhost:9000 && electron .\"",
    "start": "npm run dev:main && electron .",
    "build:renderer": "webpack --config webpack.config.js --mode production",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main && electron-builder",
    "pack": "npm run build:renderer && npm run build:main && electron-builder --dir"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.7.0",
    "postcss": "^8.4.32",
    "postcss-loader": "^7.3.0",
    "style-loader": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
